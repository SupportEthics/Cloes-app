# Trove — cloud sync configuration
# ---------------------------------
# Copy this file to ".env" and paste the two values from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# Leave them blank / delete the .env and Trove runs in on-device "local mode"
# with no backend. Fill them in and the app gains real logins + a shared,
# syncing family journal. The anon key is safe to ship — Row-Level Security
# (see supabase/schema.sql) is what protects each family's data.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
